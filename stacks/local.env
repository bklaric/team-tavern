# Environment for the local stack, which bundle.ps1 copies into dist/local/ as
# .env. Every value here is throwaway: Postgres is reachable only from inside
# the compose network, and everything else the server calls is a stand-in.

ENVIRONMENT=local

# The cluster's superuser, which the first boot of an empty data directory
# creates.
POSTGRES_USER=bklaric
POSTGRES_PASSWORD=bklaric

PGUSER=bklaric
PGPASSWORD=bklaric
PGHOST=tt-postgres
PGPORT=5432
# The site's database, which stacks/test-seed/seed.sh builds and every test run
# rebuilds. The cluster's other databases are left alone.
PGDATABASE=team_tavern_local

AWS_ACCESS_KEY_ID=0000
AWS_SECRET_ACCESS_KEY=0000

# Where reports of players are mailed.
ADMIN_EMAIL=admin@example.com

# The discord service, which stands in for Discord's API.
DISCORD_CLIENT_SECRET=0000
DISCORD_API_URL=http://tt-discord:3000/api

# The mail service, which stands in for SES's API.
AWS_ENDPOINT_URL_SESV2=http://tt-mail:3000

# The steam service, which stands in for the Steam Web API and the OpenID
# provider Steam's sign-in checks its answers with.
STEAM_API_KEY=0000
STEAM_API_URL=http://tt-steam:3000
STEAM_OPENID_URL=http://tt-steam:3000/openid/login

# The google service, which stands in for Google's token endpoint.
GOOGLE_CLIENT_SECRET=0000
GOOGLE_TOKEN_URL=http://tt-google:3000/token

# Seconds between the worker's runs, an hour elsewhere, so a spec sees the
# period's email while it waits.
WORKER_PERIOD=2

# Every spec comes from the one address, so the limits kept per client address
# are off. The others still apply.
RATE_LIMIT_CLIENTS=off
