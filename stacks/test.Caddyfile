# Plain HTTP on Caddy's port 80, which docker-compose.test.yml publishes on the
# host port CADDY_HTTP_PORT names. The host matcher ignores the port, so requests
# to localhost:<that port> land here.
#
# The prerenderer resolves `localhost` to its own container, so the site also
# answers to its compose service name, and that name is the render origin.

http://localhost, http://caddy {
    import base.Caddyfile http://caddy

    # The mail stub's page, on the site's origin, so the relative links in the
    # emails it shows open the site.
    handle /mail {
        reverse_proxy mail:3000
    }
}
