# Environment for the test stack. Every value here is throwaway: the database
# lives in a named volume that `down -v` deletes, and the ports are shifted so
# the stack runs alongside the development one.

POSTGRES_USER=teamtavern
POSTGRES_PASSWORD=teamtavern
POSTGRES_DB=team_tavern_test

DEPLOYMENT=local

PGUSER=teamtavern
PGPASSWORD=teamtavern
PGHOST=postgres
PGPORT=5432
PGDATABASE=team_tavern_test

SENDGRID_API_KEY='0000'

# Host ports for Caddy. The development stack has 80 and 443.
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443
