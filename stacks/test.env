# Environment for the test stack. Every value here is throwaway: the database
# lives in a named volume that `down -v` deletes, and the port differs from the
# development one so both stacks run at once.

POSTGRES_USER=teamtavern
POSTGRES_PASSWORD=teamtavern
POSTGRES_DB=team_tavern_test

ENVIRONMENT=test

PGUSER=teamtavern
PGPASSWORD=teamtavern
PGHOST=tt-postgres
PGPORT=5432
PGDATABASE=team_tavern_test

SENDGRID_API_KEY='0000'

# Where reports of players are mailed.
ADMIN_EMAIL=admin@example.com

# The discord service, which stands in for Discord's API.
DISCORD_API_URL=http://tt-discord:3000/api

# The mail service, which stands in for SendGrid's API.
SENDGRID_API_URL=http://tt-mail:3000/

# Seconds between the worker's runs, an hour elsewhere, so a spec sees the
# period's email while it waits.
WORKER_PERIOD=2

# Host port for Caddy, which serves plain HTTP. The development stack has 8000.
CADDY_HTTP_PORT=8080
