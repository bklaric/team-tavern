ENVIRONMENT=development

# Host port for Caddy's plain HTTP. Production leaves it unset and takes 80.
CADDY_HTTP_PORT=8000

# Ubuntu
# CADDY_DOCKER_PATH=/home/bklaric/osobno/caddy-docker
# POSTGRES_DOCKER_PATH=/home/bklaric/osobno/postgres-docker
# POSTGRES_BACKUP_PATH=/home/bklaric/osobno/postgres-backup

# Windows
CADDY_DOCKER_PATH=/c/Users/BranimirKlaric/purescript/caddy-docker
POSTGRES_DOCKER_PATH=/c/Users/BranimirKlaric/purescript/postgres-docker
POSTGRES_BACKUP_PATH=/c/Users/BranimirKlaric/purescript/postgres-backup

POSTGRES_USER=bklaric
POSTGRES_PASSWORD=bklaric
POSTGRES_DB=team_tavern

AWS_ACCESS_KEY_ID=0000
AWS_SECRET_ACCESS_KEY=0000

# Where reports of players are mailed.
ADMIN_EMAIL=admin@teamtavern.net

# Steam answers a placeholder key with 403, so a custom profile address can't
# be saved here, but a profile's numeric link or SteamID can.
STEAM_API_KEY=0000

# Google refuses to swap a code with a placeholder secret, so signing in with
# Google fails here unless the OAuth client's real secret takes its place.
GOOGLE_CLIENT_SECRET=0000
